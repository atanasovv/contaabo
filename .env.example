# ===========================================
# CONSOLIDATED ENVIRONMENT VARIABLES
# ===========================================
# This single .env file contains all environment variables
# for all services (WordPress, N8N, Traefik, etc.)

# ===========================================
# DOMAIN AND SSL CONFIGURATION
# ===========================================

# Main domain for all services
BASE_DOMAIN_NAME=coach-bg.com

# Subdomains for services
N8N_SUBDOMAIN=n8n
WORDPRESS_SUBDOMAIN=wordpress
TRAEFIK_SUBDOMAIN=traefik
PHPMYADMIN_SUBDOMAIN=phpmyadmin.internal

# Full hostnames (auto-generated from above)
WORDPRESS_HOST=${WORDPRESS_SUBDOMAIN}.${BASE_DOMAIN_NAME}
N8N_HOST=${N8N_SUBDOMAIN}.${BASE_DOMAIN_NAME}
TRAEFIK_HOST=${TRAEFIK_SUBDOMAIN}.${BASE_DOMAIN_NAME}
PHPMYADMIN_HOST=${PHPMYADMIN_SUBDOMAIN}.${BASE_DOMAIN_NAME}

# Email for SSL certificates (Let's Encrypt)
SSL_EMAIL=vladislav2502@gmail.com

# ===========================================
# WORDPRESS & MYSQL CONFIGURATION
# ===========================================

# MySQL Database Settings
WP_DB_NAME=wordpress_db
WP_DB_USER=wordpress_db
WP_DB_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# WordPress Configuration
WORDPRESS_TABLE_PREFIX=dza_

# ===========================================
# N8N & POSTGRESQL CONFIGURATION
# ===========================================

# PostgreSQL Database Settings
POSTGRES_USER=n8n_root
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=password

# N8N Configuration
GENERIC_TIMEZONE=Europe/Sofia
N8N_ENCRYPTION_KEY=d8fsd397082fa390bf761289fjdkl2897ysdlajsdfla92803slkjef290

# ===========================================
# TRAEFIK CONFIGURATION
# ===========================================

# Traefik Dashboard Access
TRAEFIK_DASHBOARD_HOST=${TRAEFIK_HOST}

# Basic Authentication (generate with: htpasswd -nb username password)
# Current: admin / admin123 (CHANGE IN PRODUCTION)
TRAEFIK_BASIC_AUTH=admin:$$2y$$10$$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi

# IP Whitelist for Admin Access
# Tailscale network: 100.64.0.0/10
# Docker networks: 172.16.0.0/12  
# Localhost: 127.0.0.1/32
ADMIN_IP_RANGE=100.64.0.0/10,172.16.0.0/12,127.0.0.1/32

# ===========================================
# PHPMYADMIN CONFIGURATION
# ===========================================

# phpMyAdmin Basic Auth (generate with: htpasswd -nb username password)
# Current: admin / pma123 (CHANGE IN PRODUCTION)
PMA_BASIC_AUTH=admin:$$2y$$10$$YourHashedPasswordHere

# phpMyAdmin IP Whitelist (same as Traefik for VPN access)
PMA_ALLOWED_IPS=100.64.0.0/10,172.16.0.0/12,127.0.0.1/32



