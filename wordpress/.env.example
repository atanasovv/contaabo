# WordPress Docker Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
WP_DB_NAME=wordpress_db
WP_DB_USER=wp_user
WP_DB_PASSWORD=your_strong_db_password_here
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# WordPress Configuration
WORDPRESS_DOMAIN=wordpress.example.com

# phpMyAdmin Configuration
# Basic Authentication for phpMyAdmin (username:password in htpasswd format)
# Generate using: htpasswd -nb username password
# Example: PMA_BASIC_AUTH=admin:$$2y$$10$$...
PMA_BASIC_AUTH=admin:$$2y$$10$$YourHashedPasswordHere

# IP Whitelist for phpMyAdmin Access
# Replace with your home IP address(es)
# You can specify multiple IPs separated by commas
# Examples:
# Single IP: PMA_ALLOWED_IPS=123.456.789.0/32
# IP Range: PMA_ALLOWED_IPS=123.456.789.0/24  
# Multiple IPs: PMA_ALLOWED_IPS=123.456.789.0/32,987.654.321.0/32
PMA_ALLOWED_IPS=YOUR_HOME_IP_HERE/32

# Backup Configuration
# Cron schedule for automated backups (default: daily at 2 AM)
# Format: minute hour day month weekday
# Examples:
# Daily at 2 AM: 0 2 * * *
# Every 6 hours: 0 */6 * * *
# Weekly on Sunday at 3 AM: 0 3 * * 0
BACKUP_SCHEDULE=0 2 * * *

# How many days to keep backup files (default: 7 days)
BACKUP_RETENTION_DAYS=7

# Security Notes:
# 1. Use strong passwords (minimum 16 characters with mixed case, numbers, and symbols)
# 2. Never commit this file with real passwords to version control
# 3. Consider using Docker secrets in production instead of environment variables
# 4. Regularly rotate your passwords
# 5. Replace YOUR_HOME_IP_HERE with your actual home IP address
# 6. Use /32 for single IP, /24 for subnet range