FROM traefik:v2.10.4

# Create directories for plugins
RUN mkdir -p /plugins-storage
RUN mkdir -p /plugins-local
RUN mkdir -p /etc/traefik/plugins-metadata

# Install necessary tools
RUN apk add --no-cache curl jq tar

# ========================
# PLUGIN: CLOUDFLARE REAL IP
# ========================
# Set environment variables for the Cloudflare Real IP plugin
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_CLOUDFLAREREAIP_MODULENAME=github.com/BetaHuhn/traefik-cloudflare-real-ip
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_CLOUDFLAREREAIP_VERSION=v0.3.0

# Download and install the plugin
RUN curl -L -o /plugins-local/plugin-cloudflare-real-ip.tar.gz \
    https://github.com/BetaHuhn/traefik-cloudflare-real-ip/releases/download/${TRAEFIK_EXPERIMENTAL_PLUGINS_CLOUDFLAREREAIP_VERSION}/plugin-cloudflare-real-ip_${TRAEFIK_EXPERIMENTAL_PLUGINS_CLOUDFLAREREAIP_VERSION}_linux_amd64.tar.gz \
    && mkdir -p /plugins-local/cloudflare-real-ip \
    && tar -xzf /plugins-local/plugin-cloudflare-real-ip.tar.gz -C /plugins-local/cloudflare-real-ip \
    && rm /plugins-local/plugin-cloudflare-real-ip.tar.gz

# ========================
# PLUGIN: RATE LIMIT
# ========================
# Set environment variables for the Rate Limit plugin
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_RATELIMIT_MODULENAME=github.com/xuanxuan0/traefik-plugin-ratelimit
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_RATELIMIT_VERSION=v0.1.3

# ========================
# PLUGIN: REWRITE HEADERS
# ========================
# Set environment variables for the Rewrite Headers plugin (useful for WordPress)
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_REWRITEHEADERS_MODULENAME=github.com/tomMoulard/htransformation
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_REWRITEHEADERS_VERSION=v0.1.6

# ========================
# PLUGIN: MAINTENANCE PAGE
# ========================
# Set environment variables for the Maintenance Page plugin
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_MAINTENANCEPAGE_MODULENAME=github.com/neilnaveen/maintenance-page
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_MAINTENANCEPAGE_VERSION=v1.0.8

# ========================
# PLUGIN: GeoBlock
# ========================
# Set environment variables for the GeoBlock plugin
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_GEOBLOCK_MODULENAME=github.com/traefik/plugin-geoip
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_GEOBLOCK_VERSION=v1.2.0

# ========================
# PLUGIN: Cache
# ========================
# Set environment variables for the Cache plugin
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_CACHE_MODULENAME=github.com/traefik/plugin-simplecache
ENV TRAEFIK_EXPERIMENTAL_PLUGINS_CACHE_VERSION=v0.1.2

# Create traefik static configuration to load all plugins
RUN echo '\
experimental:\n\
  plugins:\n\
    cloudflarereaip:\n\
      moduleName: "github.com/BetaHuhn/traefik-cloudflare-real-ip"\n\
      version: "v0.3.0"\n\
    ratelimit:\n\
      moduleName: "github.com/xuanxuan0/traefik-plugin-ratelimit"\n\
      version: "v0.1.3"\n\
    rewriteheaders:\n\
      moduleName: "github.com/tomMoulard/htransformation"\n\
      version: "v0.1.6"\n\
    maintenancepage:\n\
      moduleName: "github.com/neilnaveen/maintenance-page"\n\
      version: "v1.0.8"\n\
    geoblock:\n\
      moduleName: "github.com/traefik/plugin-geoip"\n\
      version: "v1.2.0"\n\
    cache:\n\
      moduleName: "github.com/traefik/plugin-simplecache"\n\
      version: "v0.1.2"\n\
' > /etc/traefik/plugins-metadata/plugins.yaml