# N8N Docker Environment Configuration
# Copy this file to .env and customize the values for your setup

# ===========================================
# DOMAIN AND SSL CONFIGURATION
# ===========================================

# The top level domain to serve from
DOMAIN_NAME=example.com

# The subdomain for N8N (will create: n8n.example.com)
SUBDOMAIN=n8n

# The above configuration serves N8N at: https://n8n.example.com

# Email address for Let's Encrypt SSL certificate generation
# This is required for automatic SSL certificates
SSL_EMAIL=your-email@example.com

# ===========================================
# TRAEFIK CONFIGURATION
# ===========================================

# Traefik dashboard hostname
TRAEFIK_DASHBOARD_HOST=traefik.${DOMAIN_NAME}

# Traefik Authentication (generate with: htpasswd -nb admin your-secure-password)
# Default below is admin:your-secure-password - CHANGE THIS!
TRAEFIK_AUTH_USER=admin:$$2y$$10$$PaWYKpP.zmMi/JsS8S.RC.YvQDqrnqZBqBVTLl2m9ks9IKiTVQB2e

# Admin IP Whitelist - Set to your specific IP address or range
ADMIN_IP_RANGE=192.168.1.0/24

# ===========================================
# N8N CONFIGURATION
# ===========================================

# Timezone for N8N cron jobs and scheduling
# Use standard timezone names like: Europe/London, America/New_York, etc.
GENERIC_TIMEZONE=UTC

# N8N specific settings (optional - uncomment and modify if needed)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=your-secure-password

# N8N Encryption key (generate a random 32+ character string)
# Important: Keep this secure and don't change it after initial setup
# N8N_ENCRYPTION_KEY=your-32-character-encryption-key-here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL root user credentials
POSTGRES_USER=n8n_root
POSTGRES_PASSWORD=your-secure-root-password-here
POSTGRES_DB=n8n

# PostgreSQL non-root user (used by N8N application)
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=your-secure-user-password-here

# ===========================================
# TRAEFIK DASHBOARD CONFIGURATION (Optional)
# ===========================================

# If you want to access Traefik dashboard via domain instead of IP:port
# Uncomment and set your preferred subdomain
# TRAEFIK_DASHBOARD_HOST=traefik.example.com

# Basic auth for Traefik dashboard (generate with: htpasswd -nb admin password)
# Default is admin:admin (CHANGE THIS!)
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$10$$2b2cu2.VJrTmPaOkzPvCme3UxFGl1mw/m4B3oJ8BvMC1zPK5x1x2K

# ===========================================
# SECURITY RECOMMENDATIONS
# ===========================================

# 1. Use strong passwords (minimum 16 characters)
# 2. Generate unique passwords for each service
# 3. Never commit this .env file with real passwords to version control
# 4. Consider using Docker secrets in production
# 5. Regularly rotate passwords
# 6. Use a password manager to generate secure passwords

# ===========================================
# EXAMPLE SECURE PASSWORDS (REPLACE THESE!)
# ===========================================

# Example strong password patterns:
# - Mix of upper/lowercase letters, numbers, and symbols
# - At least 16 characters long
# - Example: Kj9#mL2$pQ8&vN5@rT7!

# Sample configuration (DO NOT USE IN PRODUCTION):
# POSTGRES_PASSWORD=Kj9#mL2$pQ8&vN5@rT7!xW3
# POSTGRES_NON_ROOT_PASSWORD=P9@mK5$qL8#vN2&rT6!wX4
# N8N_ENCRYPTION_KEY=aB3$dE6*fG9#hI2&jK5@lM8!nO1$pQ4&rS7#tU0@vW3*xY6$zA9#

# ===========================================
# PRODUCTION NOTES
# ===========================================

# For production deployment:
# 1. Remove the PostgreSQL port exposure (5432:5432) from docker-compose.yml
# 2. Use Docker secrets instead of environment variables for passwords
# 3. Set up proper backup procedures for PostgreSQL data
# 4. Configure log rotation for containers
# 5. Set up monitoring and alerting
# 6. Use a reverse proxy firewall like Cloudflare
# 7. Enable fail2ban for additional security